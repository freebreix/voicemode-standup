# ===== voicemode-standup (managed block - install.ps1 replaces between markers) =====
# >>> voicemode-standup >>>

# TTS: local Piper server on :8880. The "auto" voice does per-utterance language
# detection + a stable per-session speaker (languages/pools in tts/config.env).
VOICEMODE_TTS_BASE_URLS=http://127.0.0.1:8880/v1
VOICEMODE_TTS_MODELS=tts-1
VOICEMODE_VOICES=auto
VOICEMODE_TTS_AUDIO_FORMAT=pcm
VOICEMODE_STREAMING_ENABLED=true

# STT: whisper.cpp whisper-server (large-v3-turbo) on :2022
VOICEMODE_STT_BASE_URLS=http://127.0.0.1:2022/v1
VOICEMODE_STT_AUDIO_FORMAT=wav
VOICEMODE_WHISPER_LANGUAGE=auto

# Recording auto-stop (voice-mode's own webrtcvad silence detector, upstream -
# not this repo's code). In a noisy room (fan, open mic gain) background noise
# can keep getting classified as speech, so silence never accumulates and
# recording runs all the way to the max below before "seemingly for no
# reason" cutting off - VOICEMODE_VAD_AGGRESSIVENESS is already at its
# strictest (3), so the only other lever is capping the worst case. Lower
# VOICEMODE_DEFAULT_LISTEN_DURATION further if it still happens.
VOICEMODE_DEFAULT_LISTEN_DURATION=45
# VOICEMODE_VAD_AGGRESSIVENESS=3
# VOICEMODE_SILENCE_THRESHOLD_MS=1000

VOICEMODE_PREFER_LOCAL=true
VOICEMODE_ALWAYS_TRY_LOCAL=true
VOICEMODE_AUTO_START_KOKORO=false

# Multi-agent coordination (the conch): keep it on, generous timeouts so a
# queued session waits out a long turn rather than being dropped.
VOICEMODE_CONCH_ENABLED=true
VOICEMODE_CONCH_TIMEOUT=600

# --- shim knobs (read by voicemode_standup) ---
# Default voice="auto:<session-id>" on every converse -> TTS server picks a
# stable per-session, language-aware speaker.
VOICEMODE_STANDUP_AUTOVOICE=true
# Default wait_for_conch=true on every converse (queue instead of bounce).
VOICEMODE_STANDUP_AUTOWAIT=true
# Default hold_conch=true when a reply is expected (don't get cut into mid-Q/A).
VOICEMODE_STANDUP_AUTOHOLD=true

# <<< voicemode-standup <<<
