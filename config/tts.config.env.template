# Copied to tts/config.env by install.ps1 (tts/config.env is gitignored in the fork).
# Piper-only, CPU. "auto" = synthetic voice: detect_lang() routes hu/en per request.
LANGUAGES=en,hu
ENABLED_ENGINES=piper
DEFAULT_VOICE=auto
DEVICE=cpu
TORCH_CPU_THREADS=0

# EN pool - one per parallel session (see VOICEMODE_STANDUP_VOICES). Models
# auto-download from HuggingFace on first use.
ENABLED_PIPER_VOICES_EN=amy-medium,ryan-medium,lessac-medium,hfc_female-medium,kristin-medium
ENABLED_PIPER_VOICES_HU=anna-medium
