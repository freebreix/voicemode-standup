# Copied to tts/config.env by install.ps1 (tts/config.env is gitignored).
# Piper-only, CPU. DEFAULT_VOICE=auto -> per-request language detection (lingua)
# + per-session speaker pick, both handled inside the TTS server.

# Ordered language list. First entry is the primary language: the fallback
# whenever detection is off, uncertain, or has no voice pool. A single language
# skips detection entirely. A language lingua has no model for (checked at
# startup) can only be used on its own.
TTS_LANGUAGES=en,hu
ENABLED_ENGINES=piper
DEFAULT_VOICE=auto

# true (default): reject an "auto" request whose language lingua identifies as
# one not in TTS_LANGUAGES (HTTP 400) so the agent tells the user it isn't
# supported. false: always synthesize, falling back to the primary voice.
STRICT_LANGUAGE=true

# First-pick Piper voice quality: x_low | low | medium | high.
# Nearest available quality is used when the exact one is missing.
PREFERRED_QUALITY=medium

DEVICE=cpu
TORCH_CPU_THREADS=0

# Optional per-language speaker allow-list. Entries are bare speaker names
# (resolved to PREFERRED_QUALITY) or full <name>-<quality> ids. Unset => every
# speaker defined for that language in voices_definitions.yaml. Models
# auto-download from HuggingFace on first synth. One speaker per parallel
# session; sessions share a voice once the pool is exhausted (no error).
# Misconfiguration (unknown language, no voice, no lingua model) is reported at
# GET http://127.0.0.1:8880/v1/health and logged CRITICAL at startup.
ENABLED_PIPER_VOICES_EN=amy,ryan,lessac,hfc_female,kristin
ENABLED_PIPER_VOICES_HU=anna,berta,imre
